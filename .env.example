# Port aplikasi lokal (di Render/PaaS, port akan diisi otomatis oleh environment)
PORT=3000

# Connection string PostgreSQL dari Neon.tech (atau Supabase)
# Contoh format: postgres://user:password@ep-xyz-123.ap-southeast-1.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require

# Connection string Redis dari Upstash.com (dimulai dengan rediss:// untuk enkripsi TLS)
# Contoh format: rediss://default:password@xyz.upstash.io:6379
REDIS_URL=rediss://default:password@host.upstash.io:6379
